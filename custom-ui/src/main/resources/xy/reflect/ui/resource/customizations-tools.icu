            <specificProperties/>
            <hidden>true</hidden>
            <onlineHelp>Specifies whether validation errors should be checked 
and error markers displayed for list elements. Note that 
in the case of trees, for each sublist to be checked, this 
option must be enabled for the relevant sublist, as well 
as for all its ancestors.</onlineHelp>
            <customFieldCaption>Show Validation Error Markers</customFieldCaption>
